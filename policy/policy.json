{
  "version": 1,
  "limits": {
    "memory_index_lines": 50,
    "decision_index_lines": 50,
    "rules_lines": 200,
    "rules_chars": 10000,
    "status_line_lines": 1,
    "open_topics_lines": 10,
    "skill_description_chars": 300,
    "boot_context_chars": 15000,
    "skills_list_chars": 6000,
    "handover_lines": 15,
    "repo_handover_lines": 150,
    "hook_signal_lines": 2,
    "worker_result_chars": 2000,
    "catalog_boot_lines": 2,
    "catalog_find_lines": 20,
    "catalog_line_chars": 220,
    "materialy_max_mb": 50
  },
  "destructive": {
    "removed_lines_threshold": 50,
    "removed_fraction_threshold": 0.5,
    "files_threshold": 5
  },
  "compaction": {
    "auto_compact_window_tokens": 200000
  },
  "logs": {
    "rotation_days": 30,
    "failure_signal_days": 7,
    "readonly_commands": [
      "ls",
      "cat",
      "pwd",
      "head",
      "tail",
      "git status",
      "git log",
      "git diff",
      "cd",
      "grep",
      "sed -n",
      "wc",
      "echo",
      "printf",
      "cut",
      "tr",
      "sort",
      "uniq",
      "jq",
      "awk",
      "read",
      "test",
      "[",
      "[["
    ],
    "sequence_min_length": 2,
    "sequence_max_length": 5,
    "subcommand_programs": [
      "git",
      "npm",
      "npx",
      "node",
      "docker",
      "gh",
      "kubectl",
      "pnpm",
      "yarn",
      "cargo",
      "pip",
      "make"
    ]
  },
  "thresholds": {
    "sequence_repeats": 3,
    "procedure_repeats": 3,
    "derivation_repeats": 2
  },
  "comms": {
    "hook_wait_ms": 2000
  },
  "topics": {
    "default_holder_mode": "operator",
    "thread_start_command": "t3 thread start --json",
    "brain_path_default": "../<brain-name>",
    "code_copy_path": "../<project>-topics/<id>/",
    "stale_machine_hours": 12
  },
  "subagents": {
    "default_model": "haiku",
    "synthesis_model": "sonnet"
  },
  "harness": {
    "native_memory": false,
    "deny_write_paths_subagent": [
      "<brain>/**",
      "<plugin>/bin/**"
    ],
    "brain_skills_mode": "copy-on-session-start",
    "ask_commands": [
      "git reset --hard",
      "git clean",
      "git push --force",
      "git push -f",
      "git branch -D",
      "git branch -d",
      "git stash drop",
      "git checkout --",
      "git restore",
      "git rebase -i"
    ],
    "ask_commands_except": [
      "git restore --staged",
      "git clean -n",
      "git clean --dry-run"
    ],
    "deny_paths": [
      "<brain>/**",
      "~/.claude/**"
    ],
    "denied_tools": [
      "t3_thread_send",
      "EnterWorktree"
    ],
    "subagent_denied_scripts": [
      "bin/brain.mjs",
      "bin/save.mjs",
      "bin/topic.mjs",
      "bin/done.mjs",
      "bin/brain-init.mjs",
      "bin/project.mjs"
    ],
    "subagent_stop_exempt_agent_types": [
      "Explore",
      "Plan"
    ]
  },
  "immutable_principles": [
    "P-001",
    "P-002",
    "P-013",
    "P-018",
    "P-019",
    "P-020",
    "P-035",
    "P-037",
    "P-040",
    "P-047"
  ],
  "thread_title": {
    "command": "t3 thread show --json"
  },
  "project": {
    "t3_project_add_command": "t3 project add"
  },
  "prompt": {
    "error_phrases": [
      "nefunguje",
      "to je chyba",
      "je to chyba",
      "zle si",
      "pokazil",
      "nesprávne",
      "neplatí",
      "doesn't work",
      "does not work",
      "that's a bug",
      "this is a bug",
      "broken",
      "wrong"
    ],
    "done_prompts": ["finish", "hotovo", "uzavri to", "uzavri", "uzavri tému", "done", "workflow:done"],
    "reject_phrases": [
      "nechcem",
      "nepáči sa mi",
      "nepáčí sa mi",
      "nedávaj tam",
      "nepridávaj",
      "daj to preč",
      "daj preč",
      "odstráň to",
      "to tam nebude",
      "nie takto",
      "i don't want",
      "i do not want",
      "i don't like",
      "remove that",
      "drop that"
    ],
    "save_phrases": [
      "ulož",
      "zapamätaj",
      "zapíš si",
      "páči sa mi",
      "volám sa",
      "remember this",
      "save this",
      "i like this",
      "my name is"
    ],
    "wake_template": "you have mail in topic",
    "no_reply_template": "no reply",
    "undelivered_template": "undelivered",
    "keepalive_template": "turn interrupted, continue from handover",
    "continue_template": "turn ended with a next step, continue from handover",
    "nudge_prompts": ["up", "?", "check", "ckeck"]
  }
}
