#!/usr/bin/env node
// Git hook launcher (P-040). Runs the Node shim next to it in this process (one node per hook, not three: each commit of a
// brain paid ~0.3 s for the chain, P-079); logic lives in the workflow plugin.
const path = require('node:path');
const { pathToFileURL } = require('node:url');
import(pathToFileURL(path.join(__dirname, 'pre-commit.mjs')).href).catch((e) => { process.stderr.write(`brain pre-commit: ${e?.stack || e}\n`); process.exit(1); });
